APP_DOMAIN=localhost
APP_RELEASE=stable

WEB_NEW_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
LIVE_REPLICAS=1
# Interim (NEWPIDASH-380): tag of the last published Django backend image,
# used only by the exiting migrator (the backend image is no longer published
# per-release). A custom local build overrides this with its local release.
# TODO(NEWPIDASH-380): drop once the native `pidash-api migrate up` migrator lands.
MIGRATOR_RELEASE=stable

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=http://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
API_BASE_URL=http://api:8000
# Live server the api uses to regenerate page/work-item documents on writes
LIVE_BASE_URL=http://live:3000

#DB SETTINGS
PGHOST=pi-dash-db
PGDATABASE=pi-dash
POSTGRES_USER=pi-dash
POSTGRES_PASSWORD=pi-dash
POSTGRES_DB=pi-dash
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# REDIS SETTINGS
REDIS_HOST=pi-dash-redis
REDIS_PORT=6379
REDIS_URL=

# (No RabbitMQ: the Rust worker queues in Postgres; the old pi-dash-mq
# service is gone with the frozen Django/Celery stack.)

# Rust-only edge interim (NEWPIDASH-381): explicit 1s plus a dead upstream.
# Redundant under 381's defaults but harmless, so a rollback needs no
# compose change. (Copied from the root docker-compose.yml; keep in step.)
PIDASH_RUST_WEB=1
PIDASH_RUST_APP=1
PIDASH_RUST_ASSISTANT=1
PIDASH_RUST_LOOP=1
PIDASH_RUST_PROMPTING=1
PIDASH_RUST_SPACE=1
PIDASH_RUST_LICENSE=1
PIDASH_RUST_RUNNER_WEB=1
PIDASH_RUST_API_V1=1
PIDASH_RUST_RUNNER=1
PIDASH_RUST_AUTH=1
PIDASH_DJANGO_UPSTREAM=http://127.0.0.1:9

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=



# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=


# Secret Key
# WARNING: You must set a secure, unique value for SECRET_KEY in production environments.
# Generate one with: openssl rand -hex 32
SECRET_KEY=

# AI Assistant BYOK encryption key (Fernet format). Blank on a fresh install;
# install.sh generates one (preferring python3 cryptography, else openssl).
ASSISTANT_ENCRYPTION_KEY=

# DATA STORE SETTINGS
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://pi-dash-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# (No Gunicorn: `pidash-api serve` is single-process async; scale with
# API_REPLICAS. The old GUNICORN_WORKERS setting is gone.)

# UNCOMMENT `DOCKER_PLATFORM` IF YOU ARE ON `ARM64` AND DOCKER IMAGE IS NOT AVAILABLE FOR RESPECTIVE `APP_RELEASE`
# DOCKER_PLATFORM=linux/amd64

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT=120/minute

# Live server environment variables
# WARNING: You must set a secure, unique value for LIVE_SERVER_SECRET_KEY in production environments.
# Generate one with: openssl rand -hex 32
LIVE_SERVER_SECRET_KEY=
