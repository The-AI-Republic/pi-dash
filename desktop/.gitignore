src-tauri/target/
src-tauri/gen/

# Merged web tree built by scripts/dev-prep.sh (bundled-dev mode).
.dev-tree/

# The repository root ignores every `scripts/` directory; these are sources.
!scripts/

# Tauri requires frontendDist (`src-tauri/dist/`) to exist at build time even
# for hot-reload-mode dev builds where dist/ isn't consumed. The committed
# placeholder index.html keeps Tauri's config loader happy on fresh clones.
# The actual SPA is generated by CI (release-desktop.yml) or locally by
# scripts/dev-prep.sh (bundled-dev mode) and replaces the placeholder — those
# generated assets are gitignored.
!src-tauri/dist/
src-tauri/dist/*
!src-tauri/dist/index.html
