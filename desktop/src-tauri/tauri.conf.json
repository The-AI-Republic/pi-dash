{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Dash",
  "version": "0.3.0",
  "identifier": "com.airepublic.pidash.oss",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": {
      "script": "bash scripts/dev-prep.sh",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "bash scripts/dev-prep.sh",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "bin/*",
      "licenses/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pidash"
        ]
      }
    }
  }
}
