{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Dash",
  "version": "0.3.3",
  "identifier": "com.airepublic.pidash.oss",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": {
      "script": "bash scripts/dev-prep.sh",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "bash scripts/dev-prep.sh",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://cdn.jsdelivr.net https://images.unsplash.com",
        "frame-src": "https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "resources": ["bin/*", "licenses/*"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pidash"]
      }
    }
  }
}
