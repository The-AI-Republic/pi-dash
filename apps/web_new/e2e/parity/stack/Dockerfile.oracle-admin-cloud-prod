# The cloud-edition admin parity oracle as a production build (NEWFRONT-446):
# the old admin app (apps/admin) with the private overlay's single admin
# file swapped on top, compiled once and served as static files by nginx.
# Selected with PARITY_ORACLE_EDITION=cloud (see README.md);
# Dockerfile.oracle-admin-prod is the OSS variant.
#
# Build context is the repo root. The layering mirrors
# Dockerfile.oracle-admin-prod with one added layer: after the OSS
# sources are copied and installed, the staged overlay admin subtree
# (ee-overlay/apps/admin — exactly one file, the cloud home-page
# override — copied from the runner-local overlay checkout into
# .cloud-staging/ at bring-up; never committed) lands on the matching
# OSS path. Only the old app's inputs plus the staging directory are
# ever copied in: apps/web_new, the new packages (kit, api-client),
# apps/api and the e2e specs stay out, so edits outside the old app and
# the overlay reuse every layer.
#
# The overlay COPY sits between the install and the package builds on
# purpose, mirroring Dockerfile.oracle-cloud-prod. The overlay replaces
# sources (never manifests), so the install layer stays cached across
# overlay edits; the package and app builds run after it.
#
# Like Dockerfile.oracle-admin-prod, the shared-package builds skip
# `.d.ts` generation (pre-existing TS2742 in packages/propel; fixing
# old-frontend code is outside this harness' paths) and the workspace
# install cannot be frozen.
FROM node:22-alpine AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
RUN apk add --no-cache libc6-compat && corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY pi-symbol-light.svg pi-symbol-dark.svg ./
COPY packages/constants packages/constants
COPY packages/hooks packages/hooks
COPY packages/propel packages/propel
COPY packages/services packages/services
COPY packages/tailwind-config packages/tailwind-config
COPY packages/types packages/types
COPY packages/typescript-config packages/typescript-config
COPY packages/ui packages/ui
COPY packages/utils packages/utils
COPY apps/admin apps/admin

# The workspace is partial here, so the lockfile cannot be frozen.
RUN pnpm install --no-frozen-lockfile

# The overlay layer: the cloud admin home page on top of the OSS one.
COPY apps/web_new/e2e/parity/stack/.cloud-staging/ee-overlay/apps/admin/ apps/admin/

RUN pnpm --filter "admin^..." --filter "!admin" exec sh -c 'if [ -f tsdown.config.ts ]; then tsdown --no-dts; else echo "skip: no tsdown build in $PWD"; fi'

# Vite inlines these at build time. Empty bases keep API calls and
# cross-app links same-origin; the stack's proxy routes them to Django
# and the web oracle. Admin base path matches apps/admin/Dockerfile.admin.
ENV VITE_API_BASE_URL=""
ENV VITE_API_BASE_PATH="/api"
ENV VITE_ADMIN_BASE_URL=""
ENV VITE_ADMIN_BASE_PATH="/god-mode"
ENV VITE_WEB_BASE_URL=""
ENV VITE_WEB_BASE_PATH=""
ENV VITE_SPACE_BASE_URL=""
ENV VITE_SPACE_BASE_PATH="/spaces"
ENV VITE_LIVE_BASE_URL=""
ENV VITE_LIVE_BASE_PATH="/live"
ENV VITE_WEBSITE_URL="https://airepublic.com"
ENV VITE_SUPPORT_EMAIL="support@airepublic.com"
RUN pnpm --filter=admin build

FROM nginx:1.27-alpine
COPY apps/admin/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/admin/build/client /usr/share/nginx/html/god-mode
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
