{
  "name": "web_new",
  "version": "0.0.0",
  "private": true,
  "description": "Pi Dash new frontend (web + desktop targets). Scaffold from NEWFRONT-12.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3010",
    "build": "vite build --mode web && vite build --mode desktop",
    "build:web": "vite build --mode web && node tools/prerender.mjs",
    "build:desktop": "vite build --mode desktop",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "lint": "oxlint --deny-warnings",
    "check:boundaries": "node checks/check-boundaries.mjs",
    "check:headers": "node checks/check-headers.mjs",
    "check:deps": "node checks/check-deps.mjs",
    "check:similarity": "node checks/check-similarity.mjs",
    "check:no-tauri": "node checks/check-no-tauri.mjs",
    "check:oracle-build": "node checks/check-oracle-build.mjs",
    "check:tokens": "node checks/check-tokens.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm check:headers && pnpm check:deps && pnpm check:similarity && pnpm check:tokens",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:changed": "node checks/test-changed.mjs",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config e2e/perf/playwright.perf.config.ts",
    "size": "size-limit",
    "coexistence:generate": "node checks/coexistence-routes.mjs",
    "check:coexistence": "node checks/coexistence-routes.mjs --check",
    "test:coexistence": "node --test checks/coexistence-routes.test.mjs",
    "test:size-initial": "node --test checks/size-initial.test.mjs",
    "test:parity-report": "node --test e2e/parity/report/generate.test.mjs",
    "test:parity-stack": "node --test e2e/parity/stack/parity-reaper.test.mjs e2e/parity/stack/parity-images.test.mjs e2e/parity/stack/parity-cloud.test.mjs e2e/parity/stack/parity-suite-env.test.mjs",
    "test:parity-disk-check": "node --test e2e/parity/stack/parity-disk-check.test.mjs",
    "test:parity": "node e2e/parity/tools/run-parity.mjs all",
    "test:parity:oracle": "node e2e/parity/tools/run-parity.mjs oracle",
    "test:parity:new": "node e2e/parity/tools/run-parity.mjs new",
    "parity:report": "node e2e/parity/report/generate.mjs",
    "prerender": "node tools/prerender.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@pidash/api-client": "workspace:*",
    "@pidash/kit": "workspace:*",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "^2.22.3",
    "@tiptap/extension-link": "^2.22.3",
    "@tiptap/pm": "^2.26.1",
    "@tiptap/react": "^2.22.3",
    "@tiptap/starter-kit": "^2.22.3",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.49.0",
    "markdown-it": "^14.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "^11.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-plugin": "^1.130.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.0.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "size-limit": "^11.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.0.15"
  }
}
