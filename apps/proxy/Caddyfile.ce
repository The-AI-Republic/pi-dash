{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

(pi_dash_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000

	reverse_proxy /live/* live:3000

	# Runner WebSocket upgrade — served by Django ASGI (Channels).
	reverse_proxy /ws/runner/* api:8000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* pi-dash-minio:9000
	reverse_proxy /{$BUCKET_NAME} pi-dash-minio:9000

	# BEGIN MIGRATED ROUTES (generated from apps/web_new/migrated-routes.json — do not edit; run `pnpm --filter web_new coexistence:generate`)
	redir /sign-in /sign-in/ permanent
	reverse_proxy /sign-in/* web_new:3000
	redir /sign-up /sign-up/ permanent
	reverse_proxy /sign-up/* web_new:3000
	redir /accounts /accounts/ permanent
	reverse_proxy /accounts/* web_new:3000
	redir /auth/device /auth/device/ permanent
	reverse_proxy /auth/device/* web_new:3000
	redir /invitations /invitations/ permanent
	reverse_proxy /invitations/* web_new:3000
	redir /workspace-invitations /workspace-invitations/ permanent
	reverse_proxy /workspace-invitations/* web_new:3000
	redir /onboarding /onboarding/ permanent
	reverse_proxy /onboarding/* web_new:3000
	redir /create-workspace /create-workspace/ permanent
	reverse_proxy /create-workspace/* web_new:3000
	redir /signin /signin/ permanent
	reverse_proxy /signin/* web_new:3000
	redir /login /login/ permanent
	reverse_proxy /login/* web_new:3000
	redir /register /register/ permanent
	reverse_proxy /register/* web_new:3000
	redir /home /home/ permanent
	reverse_proxy /home/* web_new:3000
	redir /docs /docs/ permanent
	reverse_proxy /docs/* web_new:3000
	redir /downloads /downloads/ permanent
	reverse_proxy /downloads/* web_new:3000
	redir /pricing /pricing/ permanent
	reverse_proxy /pricing/* web_new:3000
	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* web_new:3000
	# END MIGRATED ROUTES
	reverse_proxy /* web:3000
}

{$SITE_ADDRESS} {
	import pi_dash_proxy
}
