    "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"> \n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\" >\n  <head>\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Updates on issue</title>\n    <style type=\"text/css\" emogrify=\"no\"> html { font-family: system-ui; } p, h1, h2, h3, h4, ol, ul { margin: 0; } h-full { height: 100%; } a:hover { color: #3358d4 !important; } </style>\n    <style> *[class=\"gmail-fix\"] { display: none !important; } </style>\n    <style type=\"text/css\" emogrify=\"no\"> @media (max-width: 600px) { .gmx-killpill { content: \" \\03D1\"; } } </style>\n  </head>\n  <body bgcolor=\"#ffffff\" text=\"#3b3f44\" link=\"#006399\" yahoo=\"fix\" style=\"background-color: #f7f9ff; margin: 20px\" >\n    <div style=\" width: 600px; table-layout: fixed; height: 100%; margin-left: auto; margin-right: auto; \" >\n      <!-- Header --> \n      <div>\n        <table style=\"width: 600px\" cellspacing=\"0\">\n          <tr>\n            <td>\n              <div style=\"margin-left: 30px; margin-bottom: 20px; margin-top: 20px\" > <img src=\"/static/logos/Logo.png\" width=\"150\" border=\"0\" /> </div>\n            </td>\n          </tr>\n        </table>\n      </div>\n      <!-- Body --> \n      <div style=\" color: #1f2d5c; padding: 30px; border-radius: 4px; background-color: #fcfcfd; max-width: 100%; \" >\n        <div>\n          <table style=\"width: 100%\">\n            <tr>\n              <td>\n                <p style=\"font-size: 1rem; color: #1f2d5c; font-weight: 600\"> PROJ-12 updates </p>\n                <p style=\"font-size: 1rem; font-weight: 500; color: #1f2d5c; line-height: 28px\"> acme/<a target=\"_blank\" style=\"color: #1f2d5c; text-decoration: none;\" href=\"http://localhost/acme/projects/p1/issues/\">Rocket</a>/<a style=\"color: #1f2d5c; text-decoration: none;\" target=\"_blank\" href=\"http://localhost/acme/projects/p1/issues/i1\">PROJ-12</a>: Fix &lt;login&gt; &amp; &quot;auth&quot; / path&#x27;s </p>\n              </td>\n            </tr>\n          </table>\n          <hr style=\" background-color: #f0f0f3; height: 1px; border: 0; margin-top: 15px; margin-bottom: 15px; \" />\n           \n          <p style=\"font-size: 1rem;color: #1f2d5c; line-height: 28px\"> Updates were made to the issue by <span style=\"font-size: 1rem; font-weight: 700; line-height: 28px\">  Ada Lovelace  </span>and others. </p>\n           <!--  <p style=\"font-size: 1rem;color: #1f2d5c; line-height: 28px\"> There are  new updates and  new comments on the issue. </p>  -->   <!-- Issue title updated --> \n          <p style=\"font-size: 1rem; line-height: 28px; color: #1f2d5c\"> The issue title has been updated to Fix &lt;login&gt; &amp; &quot;auth&quot; / path&#x27;s </p>\n           <!-- Outer update Box start -->  \n          <div style=\" background-color: #f7f9ff; border-radius: 8px; border-style: solid; border-width: 1px; border-color: #c1d0ff; padding: 20px; margin-top: 15px; max-width: 100%; \" >\n            <!-- Block Heading --> \n            <div style=\"padding-bottom: 20px\">\n              <p style=\"font-size: 0.8rem; font-weight: 600; color: #121a26\"> Updates </p>\n            </div>\n            <!-- Property Updates --> \n            <div style=\" background-color: white; max-width: 100%; overflow: hidden; overflow-wrap: break-word; word-wrap: break-word; padding-left: 15px; padding-bottom: 15px; border-radius: 8px; \" >\n              <!-- action performer --> \n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 100%\" >\n                <tr style=\"border-radius: 8px; margin-top: 20px\">\n                  <td style=\"width: 30px\">\n                     <img src=\"http://localhost/avatars/ada.png\" width=\"25\" height=\"25\" border=\"0\" />  \n                  </td>\n                  <td style=\"padding-top: 20px; padding-bottom: 20px\">\n                    <p style=\" font-weight: 500; font-size: 0.8rem; color: #1c2024; width: fit-content; margin-left: 5px; \" > Ada Lovelace </p>\n                  </td>\n                  <td>\n                    <p style=\" font-weight: 500; font-size: 0.6rem; color: #80838d; margin-left: 10px; \" > 13:00 PM </p>\n                  </td>\n                </tr>\n              </table>\n               <!-- due date changed --> \n              <table role=\"presentation\" style=\"max-width: 100%; padding-bottom: 15px\" >\n                <tr>\n                  <td> <img src=\"https://pi-dash-marketing.s3.ap-south-1.amazonaws.com/pi-dash-assets/emails/due-date.png\" width=\"12\" height=\"12\" border=\"0\" style=\"display: block\" /> </td>\n                  <td style=\"padding: 0px; text-align: center\">\n                    <div>\n                      <p style=\" padding: 0px; margin: 0px; font-size: 0.8rem; font-weight: 500; color: #525252; \" > Due Date: </p>\n                    </div>\n                  </td>\n                  <td>\n                     \n                    <p style=\" font-size: 0.8rem; font-weight: 500; color: #171717; margin-left: 5px; padding: 0px; text-decoration: line-through; \" > 2026-01-01 </p>\n                     \n                  </td>\n                </tr>\n              </table>\n                <!-- duplicate changed --> \n              <table role=\"presentation\" style=\"max-width: 100%; padding-bottom: 15px\" >\n                <tr>\n                  <td> <img src=\"https://pi-dash-marketing.s3.ap-south-1.amazonaws.com/pi-dash-assets/emails/duplicate.png\" width=\"12\" height=\"12\" border=\"0\" style=\"display: inline-block\" /> <span style=\" font-size: 0.8rem; font-weight: 500; color: #525252; \" > Duplicate: </span> </td>\n                 