mment) where deleted_at null"],"db_table":"git_comment_syncs","indexes":["git_comment_comment_idx(comment)"],"ordering":["-created_at"],"source":"db/models/integration/git.py:190-223"},"GitIssueSync":{"base":"ProjectBaseModel","columns":["binding FK GitRepositoryBinding CASCADE","issue FK Issue CASCADE","provider varchar(32)","external_id varchar(255) default ''","external_iid varchar(255)","web_url url(1000) default ''","remote_state varchar(64) default ''","remote_created_at timestamptz null","remote_updated_at timestamptz null","metadata json default {} (keys: author, remote, upstream_gone_at?, completion_comment_id?, completion_comment_error?)"],"constraints":["git_issue_uniq_iid_active: unique(binding,external_iid) where deleted_at null","git_issue_uniq_issue_active: unique(binding,issue) where deleted_at null"],"db_table":"git_issue_syncs","indexes":["git_issue_sync_issue_idx(issue)","git_issue_provider_iid_idx(provider,external_iid)"],"ordering":["-created_at"],"source":"db/models/integration/git.py:152-189"},"GitProviderAccount":{"base":"BaseModel","columns":["workspace FK Workspace CASCADE","provider varchar(32): github|gitlab","host_url url(500)","auth_type varchar(32): github_app|pat|oauth|group_token|project_token","external_account_id varchar(255) default ''","external_account_login varchar(255) default ''","display_name varchar(255) default ''","capabilities json default {}","credential_config json default {} (auth_type, host_url, token-enc)","workspace_integration FK WorkspaceIntegration SET_NULL null","status varchar(16) default connected: connected|degraded|revoked|error","verified_at timestamptz null","last_check_error text default ''","metadata json default {}"],"db_table":"git_provider_accounts","indexes":["git_pa_ws_provider_host_idx(workspace,provider,host_url)","git_pa_provider_ext_idx(provider,host_url,external_account_id)"],"ordering":["-created_at"],"source":"db/models/integration/git.py:11-64"},"GitRepository":{"base":"BaseModel","columns"