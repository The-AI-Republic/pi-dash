  "defaults_and_python_behavior": {
    "Pod_MAX_PER_PROJECT": "20 (class const models.py:68; no in-model enforcement read in D-13 \u2014 create path does not check it)",
    "Pod_default_for_project_id": "Pod.objects.filter(project_id, is_default=True).first() \u2014 default manager, so soft-deleted pods excluded; returns None when missing (models.py:173-176)",
    "Pod_manager": "objects = PodManager() filters deleted_at IS NULL on EVERY query (models.py:42-49); all_objects = plain Manager (tombstones visible)",
    "Pod_save_denorm": "save() auto-fills workspace_id from project.workspace_id when None, else RAISES ValidationError({'workspace': 'pod.workspace must match pod.project.workspace'}) on mismatch (models.py:145-159); clean() repeats the same check (:127-143). NOTE: save() does NOT call full_clean() \u2014 the enforcement lives inline in save() itself.",
    "RunnerStatus_values": ["online", "offline", "busy", "revoked"],
    "Runner_MAX_PER_USER": "5 (models.py:392). Enforced OUTSIDE the model by matcher.can_register_another (count_active < 5); desktop_bundled runners excluded from the count (matcher.py:363-372). The D-13 create endpoint does NOT check it.",
    "Runner_project": "NOT a column. @property via pod.project / pod.project_id; None when pod_id None (models.py:521-536)",
    "Runner_provisioning_default": "'manual'",
    "Runner_revoked_reason_width": "varchar(32), blank default ''",
    "Runner_save_auto_resolve": "when pod_id None and workspace_id set: if workspace has exactly one project (LIMIT 2 probe), resolve pod to that project's default pod (may stay None); multi-project or zero-project workspaces keep pod None -> DB NOT NULL violation on insert (models.py:503-519)",
    "Runner_status_default": "'offline'",
    "Runner_token_columns": "refresh/enrollment hashes varchar(128) default ''; fingerprints varchar(16) default ''; generations PositiveInteger default 0/1",
    "Runnermark_heartbeat": "sets last_heartbeat_at=now, save(update_fields=['last_heartbeat_at']) (models.py:538-540)"
  },
