  {
    "module": "issues",
    "name": "update_issue",
    "description": "Update an issue's name, description, state, or priority. Requires write access.\nChanging the state may dispatch a coding run if it moves the issue into a\ndelegated/ticking state (same as moving it in the UI). Pass parent_issue_id to\nre-parent the issue (must be another issue in the same project); pass null to\nunlink it from its current parent; omit it to leave the parent unchanged.",
    "parameters_json_schema": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description_md": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "__unset__"
        }
      },
      "required": [
        "issue_id"
      ],
      "type": "object"
    },
    "return_schema": {
      "additionalProperties": true,
      "type": "object"
    },
    "strict": null
  },
  {
    "module": "issues",
    "name": "relate_issues",
    "description": "Record a relation from ``issue`` to each of ``related_issues`` (identifiers\nlike PROJ-12, or UUIDs). relation_type is read from ``issue``'s side: one of\nblocked_by, blocking, relates_to, duplicate, start_before, start_after,\nfinish_before, finish_after, implemented_by, implements. Use blocked_by when\n``issue`` cannot finish until the related issues do. Idempotent: pairs that\nalready have this relation come back under ``unchanged``; pairs that already\nhave a different relation come back under ``conflicts`` and are not changed.\nRequires write access to ``issue``'s project.",
    "parameters_json_schema": {
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "string"
        },
        "relation_type": {
          "type": "string"
        },
        "related_issues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "issue",
        "relation_type",
        "related_issues"
      ],
      "type": "object"
    },
    "return_schema": {
      "additionalProperties": true,
      "type": "object"
    },
    "strict": null
  },
  {
    "module": "issues",
    "name": "unrelate_issues",
    "description": "Remove the ``relation_type`` relation between ``issue`` and each of\n``related_issues``. Only that exact relation is removed; pairs without it come\nback under ``not_related`` (not an error). Requires write access.",
    "parameters_json_schema": {
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "string"
        },
        "relation_type": {
          "type": "string"
        },
        "related_issues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "issue",
        "relation_type",
        "related_issues"
      ],
      "type": "object"
    },
    "return_schema": {
      "additionalProperties": true,
      "type": "object"
    },
    "strict": null
  },
