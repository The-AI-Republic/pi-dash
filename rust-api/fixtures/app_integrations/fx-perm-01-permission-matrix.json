{"_comment": "FX-PERM-01: permission matrix for all 24 D-33 URL paths (27 method rows; role x endpoint x outcome). ROLE: ADMIN=20, MEMBER=15, GUEST=5 (app/permissions/base.py:13-16). WORKSPACE level checks WorkspaceMember role; PROJECT level checks ProjectMember role with workspace-admin override (base.py:44-64). BaseAPIView default: IsAuthenticated + BaseSessionAuthentication (views/base.py:189-194) — endpoints with NO decorator still require login. allow_permission failure -> 403 {'error': \"You don't have the required permissions.\"}. Legend: OK=<success status>; 403=denied; ANY=AllowAny; AUTH=authenticated-no-role-check (manual admin checks inside return their own 403s).", "anonymous": "AllowAny routes answer without login (callback redirects login_required; app-webhook 401 on bad signature even anonymously). All other routes: denied (401/403 per DRF/session default).", "disabled_flag": "every github.py route returns 404 {'error': 'GitHub integration is disabled on this instance'} when GITHUB_SYNC_ENABLED False [github.py:82-87] — EXCEPT the app callback, which redirects (302) to the profile URL with github_app=disabled [github.py:736-737]. Checked BEFORE auth on callback/webhook.", "routes": [{"admin": "OK 201", "auth": "AUTH", "guest": "403 manual", "member": "403 manual", "method": "POST", "note": "admin re-checked manually (_is_workspace_admin) [github.py:674-678]", "path": "users/me/integrations/github/app/install/"}, {"admin": "OK 200", "auth": "AUTH", "guest": "403*", "member": "200*", "method": "GET", "note": "*sees only workspaces where ADMIN (membership filter) [github.py:628-646]", "path": "users/me/integrations/github/app/"}, {"admin": "OK 200", "auth": "AUTH", "guest": "403 manual", "member": "403 manual", "method": "POST", "note": "404 when no installation row [github.py:715-719]", "path": "users/me/integrations/github/app/refresh/"}, {"admin": "302", "auth": "ANY", "guest": "302", "member": "302", "method": "GET", "note": "anonymous -> login_required redirect (not 403) [github.py:741-742]", "path": "integrations/github/app/callback/"}, {"admin": "202", "auth": "ANY", "guest": "202", "member": "202", "method": "POST", "note": "signature IS the auth; 401 bad signature [github.py:873-874]", "path": "integrations/github/app/webhook/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "OK 200", "method": "GET", "path": "workspaces/<slug>/integrations/github/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/integrations/github/connect/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/integrations/github/disconnect/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "OK 200", "method": "GET", "path": "workspaces/<slug>/integrations/github/repos/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "OK 200", "method": "GET", "path": "workspaces/<slug>/integrations/git/providers/"}, {"admin": "OK 200/201", "auth": "WORKSPACE", "guest": "GET 200 / POST 403", "member": "GET 200 / POST 403", "method": "GET+POST", "note": "GET ADMIN/MEMBER, POST ADMIN-only [git.py:58-70]", "path": "workspaces/<slug>/integrations/git/accounts/"}, {"admin": "OK", "auth": "WORKSPACE", "guest": "GET 200 / DELETE 403", "member": "GET 200 / DELETE 403", "method": "GET+DELETE", "note": "GET ADMIN/MEMBER, DELETE ADMIN-only [git.py:98-104]", "path": "workspaces/<slug>/integrations/git/accounts/<uuid>/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "OK 200", "method": "GET", "path": "workspaces/<slug>/integrations/git/accounts/<uuid>/repos/"}, {"admin": "OK 200", "auth": "PROJECT", "guest": "OK 200", "member": "OK 200", "method": "GET", "note": "widest read in D-33 [git.py:133]", "path": "workspaces/<slug>/projects/<id>/repository/"}, {"admin": "OK 200/204*", "auth": "PROJECT", "guest": "403", "member": "403", "method": "PATCH+DELETE", "note": "*PATCH 200, DELETE 200 {bound:False} [git.py:141-154]", "path": "workspaces/<slug>/projects/<id>/repository/"}, {"admin": "OK 201", "auth": "PROJECT", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/projects/<id>/repository/bind/"}, {"admin": "OK 200", "auth": "PROJECT", "guest": "OK 200", "member": "OK 200", "method": "GET", "path": "workspaces/<slug>/projects/<id>/github/"}, {"admin": "OK 200", "auth": "PROJECT", "guest": "403", "member": "403", "method": "PATCH+DELETE", "path": "workspaces/<slug>/projects/<id>/github/"}, {"admin": "OK 201", "auth": "PROJECT", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/projects/<id>/github/bind/"}, {"admin": "OK 201", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/webhooks/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "GET", "path": "workspaces/<slug>/webhooks/ + <uuid>/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "PATCH+DELETE", "note": "PATCH 200, DELETE 204 [webhook/base.py:78-108]", "path": "workspaces/<slug>/webhooks/<uuid>/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "POST", "path": "workspaces/<slug>/webhooks/<uuid>/regenerate/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "403", "method": "GET", "path": "workspaces/<slug>/webhook-logs/<uuid>/"}, {"admin": "OK 200", "auth": "PROJECT", "guest": "403", "member": "OK 200", "method": "POST", "note": "positional decorator, default PROJECT level [external/base.py:150]", "path": "workspaces/<slug>/projects/<id>/ai-assistant/"}, {"admin": "OK 200", "auth": "WORKSPACE", "guest": "403", "member": "OK 200", "method": "POST", "path": "workspaces/<slug>/ai-assistant/"}, {"admin": "OK*", "auth": "AUTH", "guest": "OK*", "member": "OK*", "method": "GET", "note": "*any authenticated role; no role check [external/base.py:215-216]", "path": "unsplash/"}], "sources": ["app/urls/integration.py:30-119 (17)", "app/urls/webhook.py:14-31 (4)", "app/urls/external.py:12-24 (3)", "app/permissions/base.py:13-64", "app/views/base.py:189-194"]}