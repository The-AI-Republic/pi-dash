# Rust stack + live environment (NEWPIDASH-382).
# Copy to `.env` next to this file on a fresh install (`./setup.sh` does it
# and generates the three secrets below — it never overwrites an existing
# `.env`). This file is compose-first: hostnames are the compose service
# names. For host dev (`cargo run`, `pnpm dev` in apps/live) override on
# your own lines. This file is gitignored — never commit real secrets.
#
# Every key here is read by the Rust image or by live; see
# rust-api/README.md "Environment" and apps/live/src/env.ts.

# --- Database / cache (compose service names) ---
DATABASE_URL=postgresql://pi_dash:pi_dash@pi-dash-db:5432/pi_dash
REDIS_URL=redis://pi-dash-redis:6379/

# --- Secrets (generated by ./setup.sh; stable across re-runs) ---
# SECRET_KEY signs sessions and decrypts db-tier secrets. The same value is
# written to apps/api/.env so the interim Django migrator shares it.
SECRET_KEY=change-me-generate-with-setup-sh
# Fernet key(s) for AI Assistant BYOK encryption (comma-separated, first
# encrypts). Generate: python3 -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"
ASSISTANT_ENCRYPTION_KEY=change-me-generate-with-setup-sh
ASSISTANT_CRYPTO_BACKEND=fernet
# Shared by live (required) and the API's live client. The same value is
# written to apps/live/.env so host `pnpm dev` agrees with compose.
LIVE_SERVER_SECRET_KEY=change-me-generate-with-setup-sh

# --- Service wiring (compose service names) ---
PORT=8000
LIVE_BASE_URL=http://live:3000
LIVE_BASE_PATH=/live
API_BASE_URL=http://api:8000

# --- Object storage (MinIO in compose; matches root .env defaults) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://pi-dash-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
